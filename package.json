{
  "name": "paseo-req-kit",
  "version": "1.9.1",
  "description": "req-kit: a requirement-development workflow for Paseo. /req aligns a requirement in chat; the engine runs design, implementation, review and verification as Paseo agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyisf/paseo-req-kit.git"
  },
  "homepage": "https://paseo-req-kit.vercel.app/",
  "bugs": "https://github.com/yiyisf/paseo-req-kit/issues",
  "keywords": [
    "paseo",
    "agents",
    "requirements",
    "workflow",
    "claude-code",
    "codex"
  ],
  "engines": {
    "node": ">=22"
  },
  "reqKit": {
    "paseo": ">=0.11.0 <0.12.0"
  },
  "bin": {
    "req": "bin/req.mjs",
    "req-kit": "bin/req.mjs",
    "start-pipeline": "bin/start-pipeline.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./engine/test/isolate.ts --test --test-concurrency=1 engine/test/*.test.ts test/*.test.ts",
    "smoke": "tsx engine/src/smoke-test.ts",
    "doctor": "node bin/req-doctor.mjs",
    "eval": "tsx engine/src/eval.ts",
    "eval:self-check": "tsx engine/src/eval.ts --reference"
  },
  "dependencies": {
    "@getpaseo/client": "^0.11.2",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "bin/",
    "engine/src/",
    "engine/prompts/",
    "paseo-plugin/",
    "skills/",
    "principles/",
    "contracts/",
    "notifiers/",
    "docs/guide/",
    "docs/adr/",
    "install.mjs",
    "config.example.json",
    "CHANGELOG.md",
    "SCOPE.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
