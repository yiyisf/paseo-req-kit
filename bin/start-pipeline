#!/usr/bin/env bash
# Starts the requirement pipeline in the background and returns immediately.
# Same as bin/start-pipeline.mjs, for bash users. The skill uses the .mjs launcher,
# which also works from PowerShell and cmd.
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
TOOL_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
TSX="$TOOL_DIR/node_modules/.bin/tsx"
if [ ! -x "$TSX" ]; then
  TSX="$(command -v tsx || true)"
fi
if [ -z "$TSX" ]; then
  echo "未启动：找不到 tsx。请先在 $TOOL_DIR 中执行 npm install。" >&2
  exit 2
fi
exec "$TSX" "$TOOL_DIR/engine/src/launch.ts" "$@"
