{
  "daemonUrl": "ws://127.0.0.1:6767/ws",
  "daemonPasswordEnv": "PASEO_DAEMON_PASSWORD",
  "teamConfig": null,
  "agents": {
    "builder": {
      "provider": "claude/CHANGE-ME",
      "modeId": "bypassPermissions"
    },
    "reviewer": {
      "provider": "codex/CHANGE-ME",
      "modeId": "full-access"
    }
  },
  "defaultProfile": "standard",
  "profiles": {
    "quick": {
      "rounds": {
        "designReview": 1,
        "codeReview": 1,
        "defectFix": 1
      },
      "serviceStart": false
    },
    "standard": {
      "rounds": {
        "designReview": 2,
        "codeReview": 3,
        "defectFix": 3
      },
      "serviceStart": true
    }
  },
  "notifyMilestones": true,
  "notifiers": [],
  "stepTimeoutMinutes": {
    "design": 60,
    "design_review": 30,
    "design_revise": 30,
    "implement": 240,
    "code_review": 45,
    "review_fix": 90,
    "service_start": 30,
    "verify": 120,
    "defect_fix": 120,
    "reverify": 90,
    "report": 30,
    "panel_review": 45,
    "spec_review": 20,
    "design_proposal": 45,
    "handoff": 30
  },
  "waitChunkSeconds": 600,
  "permissionPollSeconds": 30,
  "resultFollowUps": 2,
  "attachToOriginChat": true,
  "archiveStepAgents": false,
  "retry": {
    "attempts": 2,
    "backoffSeconds": [
      60,
      300
    ]
  },
  "paseoServices": "auto",
  "serviceReadySeconds": 120,
  "quotaWarnPercent": 85,
  "specReview": "standard",
  "designProposals": {
    "enabled": false,
    "profiles": [
      "standard"
    ],
    "members": []
  },
  "browserVerify": "auto",
  "reviewPanel": {
    "enabled": false,
    "steps": [
      "design_review",
      "code_review"
    ],
    "profiles": [
      "standard"
    ],
    "members": []
  },
  "maxConcurrentPipelines": 0,
  "waitingReminderHours": 24,
  "autoResumeMinutes": 30,
  "autoResumeMax": 2,
  "watchdogMinutes": 60,
  "selfHeal": true,
  "answerQuestionsFirst": true,
  "phases": {
    "mode": "continuous",
    "verify": {
      "environment": "local",
      "agents": {},
      "defects": "fix",
      "serviceStart": null
    }
  },
  "requirementTypes": [
    "defect",
    "refactor",
    "assessment"
  ],
  "checks": [],
  "qualityGate": {
    "fixAttempts": 2,
    "timeoutMinutes": 20
  },
  "slices": {
    "profiles": [
      "standard"
    ],
    "max": 6
  },
  "relatedRepos": [],
  "designApproval": {
    "mode": "ui",
    "profiles": [
      "standard"
    ],
    "autoContinueHours": 0
  },
  "reviewAxes": {
    "enabled": true,
    "profiles": [
      "standard"
    ]
  }
}
