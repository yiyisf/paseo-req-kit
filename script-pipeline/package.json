{
  "name": "requirement-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Runs steps 3–11 of the requirement workflow as Paseo agents, launched from the chat that aligned the requirement.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "start-pipeline": "bin/start-pipeline"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "smoke": "tsx src/smoke-test.ts"
  },
  "dependencies": {
    "@getpaseo/client": "^0.11.2",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
